# Gemini (default)
LLM_PROVIDER=gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
# LLM_MODEL=gemini-3.5-flash-lite

# For an OpenAI-compatible provider, use these instead:
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=replace-with-your-provider-api-key
# LLM_MODEL=your-model-name

# Keep this value stable when changing providers to preserve signed quota cookies.
CHAT_COOKIE_SECRET=replace-with-a-long-random-secret
